<div class={{this.rootClass}}>
  <button type="button" class={{this.buttonClass}} style={{this.buttonStyle}} disabled={{this.locked}} title={{this.tip}} {{on "click" this.selectFirst}}>{{this.text}}</button>
  {{#if this.locked}}<span class="sf-tip" role="tooltip" style={{this.tipStyle}}>{{this.tip}}</span>{{/if}}
</div>
