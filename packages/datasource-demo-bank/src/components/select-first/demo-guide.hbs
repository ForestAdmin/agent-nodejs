<div class="dg" style={{this.rootStyle}}>
  {{#if this.guide}}
    <div class="dg-head">
      <span class="dg-badge">{{this.guide.badge}}</span>
      <span class="dg-ref">{{this.reference}}</span>
    </div>
    <div class="dg-title">{{this.guide.title}}</div>
    <p class="dg-intro">{{this.guide.intro}}</p>
    <ol class="dg-steps">
      {{#each this.steps as |step|}}
        <li class={{step.className}}>
          <span class="dg-mark">{{step.mark}}</span>
          <span class="dg-body">
            <span class="dg-step-title">{{step.title}}</span>
            <span class="dg-detail">{{step.detail}}</span>
            {{#if step.warn}}<span class="dg-warn">{{step.warn}}</span>{{/if}}
            {{#if step.button}}
              <button type="button" class="dg-btn" disabled={{this.starting}} {{on "click" this.startWorkflow}}>{{if this.starting this.startLabel step.button}}</button>
            {{/if}}
          </span>
        </li>
      {{/each}}
    </ol>
    {{#if this.end}}
      <div class="dg-end">
        <span class="dg-end-title">{{this.end.title}}</span>
        <span class="dg-end-text">{{this.end.text}}</span>
      </div>
    {{/if}}
    {{#if this.workflowNote}}<p class="dg-failed">{{this.workflowNote}}</p>{{/if}}
    {{#if this.failed}}<p class="dg-failed">The agent does not answer: are the ticks late? Is it running?</p>{{/if}}
  {{else}}
    <div class="dg-empty">
      <span class="dg-badge">Guide</span>
      <p>{{this.empty}}</p>
    </div>
  {{/if}}
</div>
