<div class="dm" style={{this.rootStyle}}>
  <header class="dm-head">
    <div class="dm-head-text">
      <span class="dm-badge">Data model</span>
      <h1 class="dm-title">How this bank’s data fits together</h1>
      <p class="dm-intro">Everything Forest shows is read live from the bank’s own database, through its agent: Forest sees the shape of the tables, never the rows. Tables are grouped by domain; Smart Actions are the operations the teams run on them.</p>
    </div>
    <div class="dm-stats">
      {{#each this.stats as |s|}}
        <div class="dm-stat"><span class="dm-stat-value">{{s.value}}</span><span class="dm-stat-label">{{s.label}}</span></div>
      {{/each}}
    </div>
  </header>

  {{#if this.map}}
    <div class="dm-body">
      <nav class="dm-domains">
        {{#each this.domains as |d|}}
          <button type="button" class={{d.className}} {{on "click" (fn this.pickDomain d.index)}}>
            <span class="dm-domain-icon">{{d.icon}}</span>
            <span class="dm-domain-text"><span class="dm-domain-name">{{d.name}}</span><span class="dm-domain-meta">{{d.meta}}</span></span>
          </button>
        {{/each}}
      </nav>

      <section class="dm-main">
        <div class="dm-domain-head">
          <h2 class="dm-h2">{{this.domain.icon}} {{this.domain.name}}</h2>
          <p class="dm-blurb">{{this.domain.blurb}}</p>
        </div>

        <div class="dm-map">
          <svg viewBox={{this.mapView.viewBox}} class="dm-svg" role="img" aria-label="How the domain’s tables link">
            {{#each this.mapView.lines as |l|}}
              <line x1={{l.x1}} y1={{l.y1}} x2={{l.x2}} y2={{l.y2}} class="dm-line"></line>
            {{/each}}
            {{#each this.mapView.nodes as |n|}}
              <g class={{n.className}} {{on "click" (fn this.pickTable n.name)}}>
                <rect x={{n.x}} y={{n.y}} width={{n.width}} height={{n.height}} rx="8"></rect>
                <text x={{n.tx}} y={{n.ty}} text-anchor="middle">{{n.label}}</text>
              </g>
            {{/each}}
          </svg>
          {{#if this.mapView.outside}}<span class="dm-outside">↔ linked to {{this.mapView.outside}} tables in other domains</span>{{/if}}
        </div>

        {{#if this.table}}
          <div class="dm-detail">
            <div class="dm-detail-head">
              <button type="button" class="dm-back" {{on "click" this.closeTable}}>← All {{this.domain.name}} tables</button>
              <h3 class="dm-h3">{{this.table.label}} <span class="dm-rows">{{this.table.rowsText}} rows</span></h3>
              <p class="dm-blurb">{{this.table.purpose}}</p>
              <button type="button" class="dm-open" {{on "click" (fn this.openInForest this.table.name)}}>Open in Forest →</button>
            </div>
            <div class="dm-detail-cols">
              <div class="dm-col">
                {{#if this.table.belongsTo}}
                  <h4 class="dm-h4">Belongs to</h4>
                  <div class="dm-chips">{{#each this.table.belongsTo as |l|}}<button type="button" class="dm-chip dm-chip--link" {{on "click" (fn this.pickTable l.table)}}>{{l.label}}</button>{{/each}}</div>
                {{/if}}
                {{#if this.table.hasMany}}
                  <h4 class="dm-h4">Has many</h4>
                  <div class="dm-chips">{{#each this.table.hasMany as |l|}}<button type="button" class="dm-chip dm-chip--link" {{on "click" (fn this.pickTable l.table)}}>{{l.label}}</button>{{/each}}</div>
                {{/if}}
                {{#if this.table.actions}}
                  <h4 class="dm-h4">⚡ Smart Actions</h4>
                  <ul class="dm-list">
                    {{#each this.table.actions as |a|}}<li class="dm-action"><strong>{{a.name}}</strong><span>on {{a.on}}</span></li>{{/each}}
                  </ul>
                {{/if}}
              </div>
              <div class="dm-col">
                <h4 class="dm-h4">Fields in the database</h4>
                <div class="dm-chips">{{#each this.table.fields as |f|}}<span class="dm-chip">{{f.name}} <em>{{f.typeText}}</em></span>{{/each}}</div>
                {{#if this.table.computed}}
                  <h4 class="dm-h4">Computed by the agent, for the desks</h4>
                  <p class="dm-note">Added in the agent’s code, with no change to the database: the case file, the checks, the risk lines.</p>
                  <div class="dm-chips">{{#each this.table.computed as |f|}}<span class="dm-chip dm-chip--computed">{{f.name}}</span>{{/each}}</div>
                {{/if}}
              </div>
            </div>
          </div>
        {{else}}
          <div class="dm-cards">
            {{#each this.cards as |t|}}
              <button type="button" class={{t.className}} {{on "click" (fn this.pickTable t.name)}}>
                <span class="dm-card-head"><span class="dm-card-name">{{t.label}}</span><span class="dm-rows">{{t.rowsText}}</span></span>
                <span class="dm-card-purpose">{{t.purpose}}</span>
                <span class="dm-card-meta">{{t.meta}}</span>
              </button>
            {{/each}}
          </div>
        {{/if}}
      </section>
    </div>
  {{else}}
    <p class="dm-loading">{{if this.failed "The agent does not answer: is it running?" "Reading the bank’s data model…"}}</p>
  {{/if}}
</div>
