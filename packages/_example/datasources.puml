}
note bottom: TABLE IN MYSQL

class COUNTERPARTIES {
  String name
  Enum risk_level
}
note bottom: TABLE IN MYSQL

class CHARGEBACKS {
  String reference
  Number amount
  Enum status
}
note bottom: TABLE IN MSSQL

class DISPUTE_REQUESTS {
  String reference
  Number amount
  Enum reason
}
note bottom: TABLE IN MSSQL

class CARDS {
  String last_four_digits
  Enum status
  Enum network
}
note bottom: TABLE IN MARIADB (+ VIEW active_cards)

class ALERTS {
  String reference
  String status
