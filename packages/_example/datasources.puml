}
note bottom: REST API (IN-PROCESS)

ACCOUNTS "*" -- "1" CUSTOMERS : has
CUSTOMERS "*" -- "*" INDIVIDUALS : customer_members
CUSTOMERS "0-1" -- "1" BUSINESSES : has
TRANSACTIONS "*" -- "1" COUNTERPARTIES : has
