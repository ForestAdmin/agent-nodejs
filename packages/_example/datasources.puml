@startuml
!pragma layout smetana
!theme cyborg-outline

title: DataSources not connected

class CUSTOMERS {
  String display_name
  Enum status
  Enum risk_rating
}
note bottom: TABLE IN POSTGRES

class INDIVIDUALS {
  String first_name
  String last_name
