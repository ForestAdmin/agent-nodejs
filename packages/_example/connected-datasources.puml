@startuml
!pragma layout smetana
!theme cyborg-outline

title: DataSources connected with ForestAdmin

class CUSTOMERS {
  .. Fields ..
  String display_name
  Enum status
}

class INDIVIDUALS {
  .. Fields ..
  String first_name
  String last_name
  .. Computed ..
  String full_name
  .. Validations ..
  first_name, last_name, email
}

class ACCOUNTS {
  .. Fields ..
  String iban
  Number overdraft_limit
  .. Actions ..
  RaiseTheOverdraftLimit()
  TestDynamicForm()
}

class TRANSACTIONS {
  .. Fields ..
  Number amount
  String description
}

class COUNTERPARTIES {
  .. Fields ..
  String name
}

class CARDS {
  .. Fields ..
  String last_four_digits
  Enum status
  .. Imported ..
  String holder_full_name
  .. Removed ..
  card_token
  .. Actions ..
  FreezeCard()
  UnfreezeCard()
  CreateNewCard()
}

class ALERTS {
  .. Fields ..
  String reference
  String status
  .. Computed ..
  Int days_open
  .. Segments ..
  StaleAlerts()
  .. Actions ..
  EscalateAlert()
}

class INVESTIGATIONS {
  .. Fields ..
  String reference
}

class SAR_REPORTS {
  .. Fields ..
  String reference
}

class CHARGEBACKS {
  .. Fields ..
  String reference
  Number amount
  .. Computed ..
  Int linked_transactions
}

class DISPUTE_REQUESTS {
  .. Fields ..
  String reference
  .. Renamed ..
  Number disputed_amount
}

class KYC_CASES {
  .. Fields ..
  String reference
  Enum status
  .. Actions ..
  ApproveOrReject()
  AttachADocument()
}

class CARD_TRANSACTIONS {
  .. Fields ..
  Number original_amount
  String device@@@individual_id
  .. Actions ..
  OpenChargeback()
}

class CARD_MERCHANTS {
  .. Fields ..
  String name
  Enum category
}

ACCOUNTS "*" -- "1" CUSTOMERS : has
CUSTOMERS "*" -- "*" INDIVIDUALS : members
CARDS "*" -- "1" ACCOUNTS : has
CARDS "*" -- "1" CUSTOMERS : has
CARDS "*" -- "1" INDIVIDUALS : holder
TRANSACTIONS "*" -- "1" ACCOUNTS : has
TRANSACTIONS "*" -- "1" COUNTERPARTIES : has
ALERTS "*" -- "1" CUSTOMERS : has
ALERTS "*" -- "0-1" INVESTIGATIONS : has
INVESTIGATIONS "*" -- "1" CUSTOMERS : has
INVESTIGATIONS "*" -- "0-1" KYC_CASES : origin
SAR_REPORTS "*" -- "1" INVESTIGATIONS : has
CHARGEBACKS "*" -- "1" CUSTOMERS : has
CHARGEBACKS "*" -- "0-1" CARD_TRANSACTIONS : has
CHARGEBACKS "*" -- "*" DISPUTE_REQUESTS : dispute_transactions
DISPUTE_REQUESTS "*" -- "1" CUSTOMERS : has
KYC_CASES "*" -- "1" CUSTOMERS : has
CARD_TRANSACTIONS "*" -- "1" CARDS : has
CARD_TRANSACTIONS "*" -- "1" TRANSACTIONS : has
CARD_TRANSACTIONS "*" -- "1" CARD_MERCHANTS : merchant
CARD_TRANSACTIONS "*" -- "0-1" INDIVIDUALS : device_owner
CARD_MERCHANTS "*" -- "1" COUNTERPARTIES : has
@enduml
