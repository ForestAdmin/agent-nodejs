# Copy this file to .env-test and fill in your credentials
# This file is used for integration tests

OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Amazon Bedrock: any credentials the AWS default chain can resolve, plus a region.
# Tests are skipped when AWS_REGION (or AWS_DEFAULT_REGION) is unset.
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
